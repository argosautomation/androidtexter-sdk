{
  "name": "androidtexter",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript client for the Android Texter SMS API: send and receive texts through your own Android phone, with your own number. No carrier or 10DLC registration.",
  "license": "MIT",
  "author": "Cloud Communication Platform LLC",
  "homepage": "https://androidtexter.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argosautomation/androidtexter-sdk.git",
    "directory": "node"
  },
  "keywords": [
    "sms",
    "sms-gateway",
    "sms-api",
    "android",
    "text-message",
    "mms",
    "twilio-alternative",
    "10dlc",
    "androidtexter"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.cjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "bugs": {
    "url": "https://github.com/argosautomation/androidtexter-sdk/issues",
    "email": "support@androidtexter.com"
  }
}
